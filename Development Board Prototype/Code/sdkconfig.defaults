# Avoid ESP32-P4 high-revision mismatch during flash on early silicon.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Match module flash size to avoid header/runtime mismatch warning.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Keep the custom application/core-dump partition layout.
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Preserve post-mortem task stacks and registers across resets.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32

# Make USB Serial/JTAG the primary interactive console.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Credentials are encrypted by the application; hardware-backed NVS encryption
# is not provisioned on this prototype (no HMAC eFuse key block is assigned).
CONFIG_NVS_ENCRYPTION=n

# Enable FATFS long filenames for SD logging files.
CONFIG_FATFS_LFN_HEAP=y
# Keep FatFS working buffers in internal RAM. PSRAM is useful for camera frame
# storage, but it makes SDMMC/FatFS writes painfully slow on this workload.
# CONFIG_FATFS_ALLOC_PREFER_EXTRAM is not set

# Enable lightweight FreeRTOS task/runtime diagnostics for the TASK_STATS command.
# Runtime counters use esp_timer_get_time() on ESP32-P4, so the percentages are
# useful for comparing task load without adding another hardware timer.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Enable TinyUSB's Mass Storage Class implementation. The firmware provides
# custom descriptors/callbacks for the SD-card handoff, but TinyUSB still needs
# the MSC class compiled in or Windows will not see a mountable disk.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192

# The replacement board is intentionally unprovisioned. Do not enable flash
# encryption or burn flash-encryption eFuses during ordinary flashing.
CONFIG_SECURE_FLASH_ENC_ENABLED=n

# Enable PSRAM so camera frame buffers can be allocated.
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MEMTEST is not set

# Enable all supported 2-lane MIPI sensors. esp_video probes their chip IDs at
# startup, so any of these modules can be fitted without rebuilding firmware.
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW10_1920X1080_25FPS_2_LANE=y
CONFIG_CAMERA_SC2336_MIPI_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_SC2336_MIPI_DEFAULT_FMT_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_SC2336_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y

CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_15FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_15FPS=y
CONFIG_CAMERA_OV5647_CSI_LINESYNC_ENABLE=y
CONFIG_CAMERA_OV5647_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_OV5647_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="main/ov5647_custom.json"

# This driver is specifically for Arducam's IMX500 module. Its control protocol
# enumerates the formats supplied by the module firmware at runtime.
CONFIG_CAMERA_ARDUCAM_IMX500=y
CONFIG_CAMERA_ARDUCAM_IMX500_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_ARDUCAM_IMX500_MIPI_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_ARDUCAM_IMX500_MIPI_DEFAULT_FMT_RAW10_1920X1080_30FPS=y
# Use the project-local IMX500 color calibration. Other detected sensors keep
# their own profiles, so plug-and-play behavior is unchanged.
CONFIG_CAMERA_ARDUCAM_IMX500_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_ARDUCAM_IMX500_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="main/imx500_custom.json"

# Route the detected sensor through esp_video's ISP/IPA pipeline.
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=y
CONFIG_ESP_VIDEO_CHECK_PARAMETERS=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_DISABLE_MIPI_CSI_DRIVER_BACKUP_BUFFER=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_ENABLE_HW_JPEG_ENC_VIDEO_DEVICE=y

# BLE control/status over the FireBeetle's ESP32-C6 using ESP-hosted HCI/VHCI.
# The P4 runs NimBLE host code; the C6 remains the Bluetooth controller.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
